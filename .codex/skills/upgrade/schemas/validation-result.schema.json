{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ValidationResult",
  "type": "object",
  "required": ["batch_sequence", "status", "changes_applied", "validation_results", "commit_refs", "baseline_status", "baseline_untracked_files", "staged_paths", "artifact_coverage"],
  "properties": {
    "batch_sequence": { "oneOf": [{ "type": "number" }, { "type": "string", "enum": ["final"] }] },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "changes_applied": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Repo-relative forward-slash file paths exactly as printed by `git diff --cached --name-only`, optionally plus planned batch files that needed no edit (same format). Never prose descriptions or plan IDs — validator rule E11 requires staged_paths to be an exact-string subset of this array."
    },
    "validation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_type", "command_or_check", "outcome", "output"],
        "properties": {
          "criterion_type": { "type": "string" },
          "command_or_check": { "type": "string" },
          "outcome": { "type": "string", "enum": ["passed", "failed"] },
          "output": { "type": "string" },
          "evidence_path": {
            "type": "string",
            "description": "Workspace-relative path to the run-gate.js evidence JSON for this gate. Mandatory (enforced by validator rule E12) when the overall status is passed."
          }
        }
      }
    },
    "failure_summary": { "type": ["string", "null"] },
    "notes": {
      "type": "string",
      "description": "Non-fatal commentary (e.g. failed-shell-call patterns on a passed batch). This is where E8-violating failure_summary text on passed results is moved."
    },
    "commit_refs": { "type": "array", "items": { "type": "string" } },
    "baseline_status": { "type": "array", "items": { "type": "string" } },
    "baseline_untracked_files": { "type": "array", "items": { "type": "string" } },
    "staged_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Repo-relative forward-slash file paths exactly as printed by `git diff --cached --name-only` before commit — the same capture that populates changes_applied. Never prose descriptions."
    },
    "artifact_coverage": {
      "type": "object",
      "required": ["artifact_refs", "slices_loaded", "full_artifact_loaded", "deferred_items", "confidence", "reason"],
      "properties": {
        "artifact_refs": { "type": "array", "items": { "type": "string" } },
        "slices_loaded": { "type": "array", "items": { "type": "string" } },
        "file_context_refs": { "type": "array", "items": { "type": "string" } },
        "full_artifact_loaded": { "type": "boolean" },
        "deferred_items": { "type": "number" },
        "confidence": { "type": "string", "enum": ["sufficient", "insufficient"] },
        "reason": { "type": "string" }
      }
    }
  }
}
